{
  "name": "auroratv",
  "version": "0.4.1",
  "private": true,
  "description": "AuroraTV - 影视聚合播放（基于 MoonTVPlus 魔改），部署于 Cloudflare Workers",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.test.mts\"",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply auroratv-db",
    "db:migrate:remote": "wrangler d1 migrations apply auroratv-db --remote"
  },
  "dependencies": {
    "hls.js": "^1.6.19",
    "next": "15.5.27",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@opennextjs/cloudflare": "^1.20.9",
    "@types/node": "^22.7.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.27",
    "typescript": "^5.9.3",
    "wrangler": "^4.125.0"
  },
  "optionalDependencies": {
    "@ast-grep/napi-linux-arm64-gnu": "0.40.5",
    "@ast-grep/napi-linux-x64-gnu": "0.40.5",
    "@next/swc-linux-arm64-gnu": "15.5.27",
    "@next/swc-linux-x64-gnu": "15.5.27"
  }
}
